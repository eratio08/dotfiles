{
	"$schema": "https://opencode.ai/config.json",
	"lsp": false,
	"share": "manual",
	"autoupdate": false,
	"plugin": [
		"cc-safety-net",
		"@dietrichgebert/ponytail",
		"./plugins/caveman/caveman.js"
	],
	"enabled_providers": ["github-copilot", "omlx", "sparness-gateway"],
	"mcp": {
		// Default Enabled
		"context7": {
			"enabled": true,
			"type": "remote",
			"url": "https://mcp.context7.com/mcp"
		},
		"code-index": {
			"enabled": true,
			"type": "local",
			"command": ["uvx", "code-index-mcp@2.17.0"]
		},
		"opensrc": {
			"enabled": true,
			"type": "local",
			"command": ["npx", "-y", "opensrc-mcp@0.3.0"]
		},
		// Default Disabled
		"playwright": {
			"enabled": false,
			"type": "local",
			"command": ["npx", "-y", "@playwright/mcp@0.0.75"]
		},
		"opentofu": {
			"enabled": false,
			"type": "local",
			"command": ["npx", "-y", "@opentofu/opentofu-mcp-server@0.1.5"]
		},
		"chrome-devtools": {
			"enabled": false,
			"type": "local",
			"command": ["npx", "-y", "chrome-devtools-mcp@1.0.1"]
    },
    "datadog": {
      "type": "remote",
      "url": "https://mcp.datadoghq.eu/api/unstable/mcp-server/mcp?referrer_ide=opencode-plugin&plugin_version=0.7.13",
      "oauth": {}
    }
	}
}
