{
  "name": "@eratio/pi-codemode-core",
  "version": "0.1.2",
  "files": [
    "dist",
    "src"
  ],
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "engines": {
    "bun": ">=1.4.0",
    "node": ">=24.0.0"
  },
  "scripts": {
    "build": "rolldown -c",
    "test": "bun run build && bun test tests",
    "typecheck": "bun run build && tsc --noEmit",
    "check": "biome check .",
    "prepack": "bun run build"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./output": {
      "types": "./dist/output.d.ts",
      "import": "./dist/output.js",
      "default": "./dist/output.js"
    }
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.12",
    "@types/bun": "^1.4.2",
    "@types/node": "^24.5.2",
    "rolldown": "^1.2.10",
    "rolldown-plugin-dts": "^0.28.6",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "effect": "4.0.0-rc.112",
    "jiti": "2.7.0"
  }
}
