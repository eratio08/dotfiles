{
  "name": "pi-agent-extensions",
  "private": true,
  "workspaces": [
    "*",
    "lib/*"
  ],
  "overrides": {
    "undici": "^8.9.0",
    "@biomejs/biome": "2.6.4"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.4"
  },
  "scripts": {
    "check": "bun run --filter '*' check",
    "setup": "bun install --filter './lib/*' --frozen-lockfile && bun run --filter './lib/*' build && bun install --filter './*' --frozen-lockfile",
    "test": "bun run --filter '*' test",
    "typecheck": "bun run --filter '*' --if-present typecheck"
  }
}
