{
	"mcpServers": {
		"ripwire": {
			"enabled": true,
			"command": "ripwire",
			"args": [
				"--mcp"
			],
			"exposure": "codemode-deferred"
		},
		"context7": {
			"enabled": true,
			"url": "https://mcp.context7.com/mcp",
			"exposure": "codemode-deferred"
		},
		"code-index": {
			"enabled": true,
			"command": "uvx",
			"args": [
				"code-index-mcp@2.17.1"
			],
			"exposure": "codemode-deferred"
		},
		"aws-mcp": {
			"enabled": false,
			"command": "uvx",
			"args": [
				"mcp-proxy-for-aws==1.6.4",
				"https://aws-mcp.eu-central-1.api.aws/mcp"
			],
			"exposure": "codemode-deferred"
		},
		"opentofu": {
			"enabled": true,
      "url": "https://mcp.opentofu.org/mcp",
			"exposure": "codemode-deferred"
		},
		"playwright": {
			"enabled": false,
			"command": "bunx",
			"args": [
				"-y",
				"@playwright/mcp@1.63.0"
			],
			"exposure": "codemode-deferred"
		},
		"chrome-devtools": {
			"enabled": true,
			"command": "bunx",
			"args": [
				"-y",
				"chrome-devtools-mcp@1.9.0",
				"--no-usage-statistics"
			],
			"exposure": "codemode-deferred"
		}
	}
}
