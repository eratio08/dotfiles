{
	"mcp": {
		"toolMode": "proxy",
		"startup": "lazy",
		"context7": {
			"enabled": true,
			"type": "remote",
			"url": "https://mcp.context7.com/mcp"
		},
		"code-index": {
			"enabled": true,
			"type": "local",
			"command": ["uvx", "code-index-mcp@2.17.0"]
		},
		"opensrc": {
			"enabled": true,
			"type": "local",
			"command": ["npx", "-y", "opensrc-mcp@0.3.0"]
		},
		"aws-mcp": {
			"enabled": true,
			"type": "local",
			"command": [
				"uvx",
				"mcp-proxy-for-aws==1.6.4",
				"https://aws-mcp.eu-central-1.api.aws/mcp"
			]
		},
		"opentofu": {
			"enabled": true,
			"type": "local",
			"command": ["npx", "-y", "@opentofu/opentofu-mcp-server@1.0.0"]
		},
		"playwright": {
			"enabled": false,
			"type": "local",
			"command": ["npx", "-y", "@playwright/mcp@1.63.0"]
		},
		"chrome-devtools": {
			"enabled": true,
			"type": "local",
			"command": ["npx", "-y", "chrome-devtools-mcp@1.9.0", "--no-usage-statistics"]
		}
	}
}
